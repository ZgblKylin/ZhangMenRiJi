# ============================================================
# 《掌门日记》— 环境变量配置模板
# ============================================================
# Web 开发模式的可选回退配置。
# 后端会优先读取系统用户配置目录中的 config.json；
# 配置文件不存在时才读取这里的环境变量并生成用户配置。
#
# 使用方法：
#   cp .env.template backend/.env
#   编辑 backend/.env 填入数据库路径
#   然后运行 npm run web-backend + npm run web-frontend
# ============================================================

# ---- SQLite 数据库（可选）----
# DATABASE_URL=sqlite://D:/Games/ZhangMenRiJi/zhangmenriji.db

# ---- 后端服务器 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ---- Rust 日志 ----
RUST_LOG=info
