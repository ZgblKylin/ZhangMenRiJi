# ============================================================
# 《掌门日记》— 环境变量配置模板
# ============================================================
# 仅 Web 开发模式需要此文件。
# 桌面应用请使用设置面板（开始画面 ⚙️ 按钮）。
#
# 使用方法：
#   cp .env.template backend/.env
#   编辑 backend/.env 填入数据库信息
#   然后运行 npm run web-backend + npm run web-frontend
# ============================================================

# ---- PostgreSQL 数据库 ----
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=zhangmenriji

# 完整连接串（可选，如设置则忽略上方 PG_* 变量）
# DATABASE_URL=postgres://user:password@host:5432/zhangmenriji

# ---- 后端服务器 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ---- Rust 日志 ----
RUST_LOG=info
