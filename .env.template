# ============================================================
# 《掌门日记》— 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值
#   cp .env.template .env
#
# 加载优先级：
#   1. DATABASE_URL（如设置则直接使用）
#   2. PG_* 变量拼合
#   3. 系统环境变量
# ============================================================

# ---- PostgreSQL 数据库 ----
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=zhangmenriji

# 完整连接串（可选，如设置则忽略上方 PG_* 变量）
# DATABASE_URL=postgres://user:password@host:5432/zhangmenriji

# ---- 后端服务器 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ---- Rust 日志 ----
RUST_LOG=info
